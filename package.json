{
  "name": "cmake-fetch",
  "version": "1.5.5",
  "description": "Minimal package manager for CMake based on `FetchContent`",
  "files": [
    "*.cmake"
  ],
  "workspaces": [
    "test/fixtures/*"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "brittle-node test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/cmake-fetch.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/cmake-fetch/issues"
  },
  "homepage": "https://github.com/holepunchto/cmake-fetch#readme",
  "devDependencies": {
    "bare-make": "^1.8.0",
    "brittle": "^3.7.0",
    "lunte": "^1.8.0",
    "prettier": "^3.3.3",
    "prettier-config-holepunch": "^2.0.0"
  }
}
